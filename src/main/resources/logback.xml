<configuration debug="true">
    <conversionRule conversionWord="highlightex" converterClass="com.jazzkuh.m0nitor.utils.logging.CustomLoggerColorHighlighter"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <withJansi>true</withJansi>
        <encoder>
            <pattern>%highlightex([%d{HH:mm:ss} %level]: %logger{36} - %msg) %n</pattern>
        </encoder>
    </appender>
    <root level="debug">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>